# Trading 212 API Credentials (generate in Trading 212 -> Settings -> API (Beta))
# Keep T212_ENV=demo while testing in Practice Mode! Switch to live only when ready.
T212_ENV=demo
T212_API_KEY=
T212_API_SECRET=

# Dashboard port (local machine only)
PORT=3212

# Automated Scheduler & Risk Guardrails
AUTO_TRADE_ENABLED=false
DAILY_RUN_TIME_UK=14:45
MAX_POSITION_GBP=200
MAX_OPEN_POSITIONS=3
STOP_LOSS_PCT=3.5
TAKE_PROFIT_PCT=7.5
MAX_DAILY_LOSS_GBP=30
